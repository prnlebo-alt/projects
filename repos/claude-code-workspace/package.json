{
  "name": "market-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Market Intelligence & Opportunity Hunter — Phase 1 Evidence Engine",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @mi/db",
    "db:migrate": "npm run db:migrate -w @mi/db",
    "db:seed": "npm run db:seed -w @mi/db",
    "benchmark": "tsx packages/testing/src/benchmark/run.ts",
    "gate:phase1": "tsx packages/testing/src/benchmark/writeGateReport.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

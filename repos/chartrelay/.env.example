APP_URL=http://localhost:3000
DATABASE_PATH=./.data/chartrelay.db
# At least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Test mode: a restricted key (rk_test_...) or secret key (sk_test_...). Live keys are refused unless STRIPE_LIVE_MODE=enabled.
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` locally, or from the deployed endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
# Existing recurring prices (test mode): ChartRelay Pro $29/mo and ChartRelay Scale $99/mo.
STRIPE_PRICE_PRO=price_1UIKkVLVPzjDg7SQfKZ5bnKk
STRIPE_PRICE_SCALE=price_1UIKkWLVPzjDg7SQ5cqW50RQ
# Transactional email (verification and password reset). Leave unset locally: emails print to the server console.
# Production requires EMAIL_PROVIDER=resend with RESEND_API_KEY and a verified EMAIL_FROM address.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
# Published support address. /support and /privacy render the contact block from it; when it is unset
# both pages say the channel is being set up rather than printing an address that bounces.
SUPPORT_EMAIL=
# Response-time expectation printed on /support: a bare number of hours ("24") or a phrase.
# Defaults to "2 business days" when unset or unusable.
SUPPORT_RESPONSE_HOURS=
# Enables GET /api/admin/backup, which `npm run backup` downloads. At least 24 characters,
# e.g. `openssl rand -hex 32`. Until it is set the route answers 404 and backups cannot run.
ADMIN_TOKEN=
# Reverse proxies in front of the app that append to X-Forwarded-For (default 1). 0 = reached directly.
TRUSTED_PROXY_HOPS=
# Optional: bytes of rendered PNGs cached in SQLite (default 200 MB).
PNG_CACHE_MAX_BYTES=

# --- Legal and business identity -------------------------------------------------
# Deliberately unset by default. The legal pages omit what is missing rather than printing a
# placeholder, and lifecycle email refuses to send without a postal address. See src/lib/business.ts.
BUSINESS_POSTAL_ADDRESS=
LEGAL_GOVERNING_STATE=Florida
LEGAL_EFFECTIVE_DATE=
# Only once a Florida fictitious name is actually registered (§865.09). Asserting one that is not
# filed is a claim the state has not agreed to.
LEGAL_DBA=

# --- Billing ---------------------------------------------------------------------
# One price ID per paid tier, plus the one-time render pack. A deployment that can sell
# subscriptions but not packs is half-configured, and the half missing is the pay-as-you-go path.
STRIPE_PRICE_DEVELOPER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PACK=

# Set to 1 for a genuine first deployment or a restore. At any other time the app refuses to start
# when the database directory is missing, because opening SQLite there would silently create an empty
# database and every credit check would pass against no balance.
ALLOW_DB_BOOTSTRAP=

# Market Intelligence — Phase 1 environment template.
# Copy to .env and fill in locally. Never commit real secrets.

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_intelligence

# --- Object storage abstraction (Phase 1 default: local filesystem fake) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
# S3-compatible (optional, only used if STORAGE_DRIVER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Search / Fetch adapters (Phase 1 default: fixture adapters, no key required) ---
SEARCH_ADAPTER=fixture
FETCH_ADAPTER=fixture
BROWSER_ADAPTER=playwright

# --- Model adapters (Phase 1 default: fake/deterministic adapter, no key required) ---
MODEL_ADAPTER=fake
# Qwen is optional and NOT required for core Phase 1 tests/implementation.
QWEN_API_KEY=
QWEN_BASE_URL=
# Frontier model is optional; only used for ambiguous adjudication in later phases.
FRONTIER_MODEL_API_KEY=

# --- Determinism / audit ---
AUDIT_SAMPLE_SEED=phase1-default-seed
MATERIALITY_RULESET_VERSION=1

# --- Run budgets (Phase 1 baseline controls) ---
RUN_TOKEN_BUDGET=200000
RUN_MONETARY_BUDGET_USD=5
RUN_SOURCE_BUDGET=50
